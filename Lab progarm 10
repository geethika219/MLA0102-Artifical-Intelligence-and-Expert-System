
import heapq

def greedy_best_first_search(graph, heuristic, start, goal):
    visited = set()
    pq = [(heuristic[start], start)]
    parent = {start: None}

    while pq:
        h, node = heapq.heappop(pq)

        if node in visited:
            continue

        visited.add(node)
        print("Visited:", node)

        if node == goal:
            path = []
            while node is not None:
                path.append(node)
                node = parent[node]

            path.reverse()
            print("Path:", " -> ".join(path))
            return

        for neighbour, cost in graph[node]:
            if neighbour not in visited and neighbour not in parent:
                parent[neighbour] = node
                heapq.heappush(
                    pq, (heuristic[neighbour], neighbour)
                )

    print("Goal not found")


graph = {
    'A': [('B', 2), ('C', 4)],
    'B': [('D', 3), ('E', 5)],
    'C': [('F', 2)],
    'D': [],
    'E': [('G', 2)],
    'F': [('G', 3)],
    'G': []
}

heuristic = {
    'A': 7,
    'B': 6,
    'C': 4,
    'D': 5,
    'E': 2,
    'F': 3,
    'G': 0
}

greedy_best_first_search(graph, heuristic, 'A', 'G')
