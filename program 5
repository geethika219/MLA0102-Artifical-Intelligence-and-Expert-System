
from collections import deque

def bfs(graph, start, goal):
    queue = deque([[start]])
    visited = {start}

    while queue:
        path = queue.popleft()
        node = path[-1]

        if node == goal:
            return path

        for neighbour in graph[node]:
            if neighbour not in visited:
                visited.add(neighbour)
                queue.append(path + [neighbour])

    return None


def bidirectional_search(graph, start, goal):
    if start == goal:
        return [start]

    q1 = deque([[start]])
    q2 = deque([[goal]])

    visited1 = {start: [start]}
    visited2 = {goal: [goal]}

    while q1 and q2:

        # Search from source
        path1 = q1.popleft()
        node1 = path1[-1]

        for neighbour in graph[node1]:
            if neighbour not in visited1:
                visited1[neighbour] = path1 + [neighbour]
                q1.append(path1 + [neighbour])

                if neighbour in visited2:
                    return (visited1[neighbour] +
                            visited2[neighbour][-2::-1])

        # Search from goal
        path2 = q2.popleft()
        node2 = path2[-1]

        for neighbour in graph[node2]:
            if neighbour not in visited2:
                visited2[neighbour] = path2 + [neighbour]
                q2.append(path2 + [neighbour])

                if neighbour in visited1:
                    return (visited1[neighbour] +
                            visited2[neighbour][-2::-1])

    return None


graph = {
    'A': ['B', 'C'],
    'B': ['A', 'D', 'E'],
    'C': ['A', 'F'],
    'D': ['B'],
    'E': ['B', 'F'],
    'F': ['C', 'E', 'G'],
    'G': ['F']
}

path = bidirectional_search(graph, 'A', 'G')

if path:
    print("Path found:", " -> ".join(path))
else:
    print("Path not found")
